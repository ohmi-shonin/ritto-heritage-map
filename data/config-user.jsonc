// Community Mapmaker User Config
{
    "map": {
        "tileName": "OSMFJ", // タイル一覧は config-system.jsonc へ
        "viewCenter": [
            136.022,
            35.025
        ],
        "viewPitch": 30,
        "maxPitch": 60,
        "maxbounds": [
            [
                135.95000,
                34.95000
            ],
            [
                136.10000,
                35.10000
            ]
        ],
        "_maxBounds": [
            [
                135.95000,
                34.95000
            ],
            [
                136.10000,
                35.10000
            ]
        ],
        "initZoom": 12,
        "maxZoom": 23,
        "modalZoom": 19 // モーダルダイアログ表示時のズームサイズ   
    },
    "view": {
        "poiZoom": {
            // アイコンの前後位置は後ろの方が手前になる
            "historic_area": 12,
            "historic_poi": 14
        },
        "poiFilter": "filter", // listTable更新時 all:全て / filter:絞り込み / "":非連動
        "editZoom": {
            // 編集時に追加するpoiZoom
            "historic_area": 14,
            "historic_poi": 14
        }
    },
    "etc": {
        "editMode": false, // 編集メニューの表示/非表示
        "slideThumbWidth": "240",
        "modalThumbWidth": "800",
        "splashUrl": "./image/ogimage.png",
        "loadingUrl": "./image/loading.gif"
    },
    "selectItem": { // 選択リストの内容を手動記載 / 空の時は "" とする
        "menu": "",
        "action": "" // ChangeMap:背景地図切り替え
    },
    "listTable": {
        "category": "tags", // カテゴリ選択 / activity:アクティビティリスト / tags:タグ
        "target": "tags", // target名:overpass名を表示 / activity:google sheetsを表示 / tags:osm poi種別名を表示
        "allActs": true, // true: 全てのactivityを常に表示 / false: 画面内のActivityのみ表示
        "playback": {
            "view": false,
            "zoomLevel": 15,
            "timer": 4000
        },
        "download": false
    },
    "PoiView": {
        "targets": [
            "historic_area",
            "historic_poi"
        ],
        "update_mode": "all" // listTable更新時 all:全て / filter:絞り込み / "":非連動
    },
    "google": {
        "Analytics": "",
        "AppScript": "",
        "targetName": "activity"
    },
    "static": {
        "mode": false,
        "osmjson": ""
    },
    "wikipedia": {
        "marker": "wikipedia.svg",
        "api_": "wikipedia.org/w/api.php?format=json&action=query&prop=extracts%7Cimages&exintro=&explaintext=&titles=",
        "api": "wikipedia.org/api/rest_v1/page/summary/",
        "domain": "wikipedia.org",
        "tag": "wikipedia",
        "image": true
    },
    "menu": {
        "main": [
            // トップメニュー一覧
            {
                "glot-model": "about",
                "linkto": "javascript:cMapMaker.about()",
                "divider": false
            },
            {
                "glot-model": "licence_title",
                "linkto": "javascript:cMapMaker.licence()",
                "divider": false
            },
            {
                "glot-model": "develop_site",
                "linkto": "https://github.com/ohmi-shonin/ritto-heritage-map/",
                "divider": false
            },
            {
                "glot-model": "openstreetmap",
                "linkto": "https://www.openstreetmap.org/about",
                "divider": false
            }
        ],
        // 詳細表示のハンバーガーメニュー
        "modal": [
            {
                "glot-model": "osm_open",
                "linkto": "javascript:winCont.osm_open(cMapMaker.open_osmid)",
                "divider": false
            },
            {
                "glot-model": "button_close",
                "linkto": "javascript:winCont.modal_close()",
                "divider": false
            }
        ]
    },
    "historicalPeriods": {
        "periods": [
            {"key": "kofun", "name": "古墳時代", "range": "3-7世紀"},
            {"key": "asuka", "name": "飛鳥時代", "range": "592-710"},
            {"key": "nara", "name": "奈良時代", "range": "710-794"},
            {"key": "heian", "name": "平安時代", "range": "794-1185"},
            {"key": "kamakura", "name": "鎌倉時代", "range": "1185-1333"},
            {"key": "muromachi", "name": "室町時代", "range": "1336-1573"},
            {"key": "azuchi", "name": "安土桃山時代", "range": "1573-1603"},
            {"key": "edo", "name": "江戸時代", "range": "1603-1868"},
            {"key": "meiji", "name": "明治時代", "range": "1868-1912"},
            {"key": "taisho", "name": "大正時代", "range": "1912-1926"},
            {"key": "showa", "name": "昭和時代", "range": "1926-1989"},
            {"key": "heisei", "name": "平成時代", "range": "1989-2019"},
            {"key": "reiwa", "name": "令和時代", "range": "2019-"}
        ],
        "siteMapping": {
            "archaeological_site": ["kofun", "asuka", "nara"],
            "place_of_worship": ["nara", "heian", "kamakura", "muromachi", "edo"],
            "shrine": ["nara", "heian", "kamakura", "muromachi", "edo"],
            "temple": ["nara", "heian", "kamakura", "muromachi", "edo"],
            "church": ["meiji", "taisho", "showa", "heisei", "reiwa"],
            "monument": ["edo", "meiji", "taisho", "showa"],
            "memorial": ["meiji", "taisho", "showa", "heisei"],
            "heritage": ["kofun", "asuka", "nara", "heian", "kamakura", "muromachi", "edo", "meiji"]
        }
    }
}
