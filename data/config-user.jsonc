{
    "title": "Community Mapmaker",
    "map": {
        "tileName": "OSMFJ",
        "viewCenter": [
            136.022,
            35.025
        ],
        "viewPitch": 30,
        "maxPitch": 60,
        "maxbounds": [
            [
                135.95000,
                34.95000
            ],
            [
                136.10000,
                35.10000
            ]
        ],
        "_maxBounds": [
            [
                135.95000,
                34.95000
            ],
            [
                136.10000,
                35.10000
            ]
        ],
        "initZoom": 12,
        "maxZoom": 23,
        "modalZoom": 19
    },
    "view": {
        "poiZoom": {
            "historic_area": 12,
            "historic_poi": 14
        },
        "poiFilter": "filter",
        "editZoom": {
            "historic_area": 14,
            "historic_poi": 14
        }
    },
    "etc": {
        "editMode": false,
        "playback": false,
        "wikipedia": {
            "image": true
        },
        "gsheet": {
            "use": false,
            "id": "",
            "name": "",
            "cache": 0
        }
    },
    "menu": {
        "main": [
            {
                "glot-model": "activities",
                "linkto": "baselist.html",
                "divider": false
            },
            {
                "glot-model": "libc",
                "linkto": "chronology.html",
                "divider": false
            },
            {
                "glot-model": "about",
                "linkto": "#",
                "onclick": "winCont.modal_open('about');",
                "divider": true
            },
            {
                "glot-model": "licence_title",
                "linkto": "#",
                "onclick": "winCont.modal_open('licence');",
                "divider": false
            },
            {
                "glot-model": "develop_site",
                "linkto": "https://github.com/ohmi-shonin/ritto-heritage-map/",
                "divider": false
            },
            {
                "glot-model": "lang_change",
                "linkto": "#",
                "onclick": "glot.modify();",
                "divider": false
            }
        ],
        "buttons": [
            {
                "btn_class": "btn btn-light border-secondary",
                "code": "javascript:cMapMaker.shareURL()",
                "icon_class": "fas fa-clone",
                "btn_glot_name": "share_link"
            },
            {
                "btn_class": "btn btn-light border-secondary",
                "code": "javascript:alert('情報追加機能は準備中です。詳細はお問い合わせください。')",
                "icon_class": "fas fa-plus",
                "btn_glot_name": "add_activity"
            }
        ]
    },
    "historicalPeriods": {
        "periods": [
            {"key": "kofun", "name": "古墳時代", "range": "3-7世紀"},
            {"key": "asuka", "name": "飛鳥時代", "range": "592-710"},
            {"key": "nara", "name": "奈良時代", "range": "710-794"},
            {"key": "heian", "name": "平安時代", "range": "794-1185"},
            {"key": "kamakura", "name": "鎌倉時代", "range": "1185-1333"},
            {"key": "muromachi", "name": "室町時代", "range": "1336-1573"},
            {"key": "azuchi", "name": "安土桃山時代", "range": "1573-1603"},
            {"key": "edo", "name": "江戸時代", "range": "1603-1868"},
            {"key": "meiji", "name": "明治時代", "range": "1868-1912"},
            {"key": "taisho", "name": "大正時代", "range": "1912-1926"},
            {"key": "showa", "name": "昭和時代", "range": "1926-1989"},
            {"key": "heisei", "name": "平成時代", "range": "1989-2019"},
            {"key": "reiwa", "name": "令和時代", "range": "2019-"}
        ],
        "siteMapping": {
            "archaeological_site": ["kofun", "asuka", "nara"],
            "place_of_worship": ["nara", "heian", "kamakura", "muromachi", "edo"],
            "shrine": ["nara", "heian", "kamakura", "muromachi", "edo"],
            "temple": ["nara", "heian", "kamakura", "muromachi", "edo"],
            "church": ["meiji", "taisho", "showa", "heisei", "reiwa"],
            "monument": ["edo", "meiji", "taisho", "showa"],
            "memorial": ["meiji", "taisho", "showa", "heisei"],
            "heritage": ["kofun", "asuka", "nara", "heian", "kamakura", "muromachi", "edo", "meiji"]
        }
    }
}
